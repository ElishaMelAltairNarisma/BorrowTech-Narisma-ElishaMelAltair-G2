# ========================================================
# BorrowTech Environment Configuration
# Laboratory Equipment Borrowing & Inventory Management System
# ========================================================

# Django Core Settings
SECRET_KEY=django-insecure-borrowtech-super-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL / Supabase)
# For Supabase:
# Go to Supabase Project Settings -> Database -> Connection string -> URI
# Example URI format:
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# Or standard PostgreSQL URI:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/borrowtech_db
DATABASE_URL=

# Alternatively, configure discrete PostgreSQL connection parameters:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=borrowtech_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# Supabase API (Optional / Additional Services)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
